# Linear API
LINEAR_API_KEY=lin_api_xxxxxxxxxxxx
LINEAR_WEBHOOK_SECRET=your_webhook_secret_here

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/linear_roadmap

# Service
PORT=3100
API_SECRET=your_api_secret_here  # Used to protect the /sync endpoint

# Astro site deploy hooks (trigger rebuilds after sync)
# Add as many as you need, one per site
DEPLOY_HOOK_SITE_1=https://api.netlify.com/build_hooks/xxxxxxxx
DEPLOY_HOOK_SITE_2=https://api.netlify.com/build_hooks/yyyyyyyy
